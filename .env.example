# Local PostgreSQL development configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mist_avinya_db
DB_USER=postgres
DB_PASSWORD=1234
DB_DIALECT=postgres

# Server and browser client
PORT=5000
NODE_ENV=development
TZ=Asia/Kolkata
CLIENT_URL=http://localhost:5173

# Stateless JWT authentication (replace before use)
JWT_SECRET=<set-a-random-secret-of-at-least-32-characters>
JWT_EXPIRY=15m

# Config-backed administrator (replace the hash before use)
AUTH_USER_ID=00000000-0000-4000-8000-000000000001
AUTH_USER_NAME=MIST Avinya Admin
AUTH_USER_EMAIL=admin@mistavinya.local
AUTH_USER_PASSWORD_HASH=<bcrypt-hash-for-local-admin-password>
AUTH_USER_ROLE=ADMIN

# Private S3 recording configuration (runtime credentials; never commit real keys)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=mist-avinya-recordings
AWS_ACCESS_KEY_ID=<runtime-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<runtime-aws-secret-access-key>
S3_PLAYBACK_EXPIRY_SECONDS=300
