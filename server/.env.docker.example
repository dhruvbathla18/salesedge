# ============================================================================
# Docker / EC2 environment for the backend (copy to server/.env before deploy)
# ============================================================================

# --- Database ---
# Option A: AWS RDS -> set DB_HOST to the RDS endpoint (SSL is auto-enabled
#           for any non-localhost host by config/db.js).
# Option B: bundled postgres service -> set DB_HOST=postgres and start compose
#           with the "local-db" profile.
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=mist_avinya_db
DB_USER=postgres
DB_PASSWORD=change-me
DB_DIALECT=postgres

# --- Server ---
PORT=5000
NODE_ENV=production
TZ=Asia/Kolkata
# Public origin the browser uses to reach the app (EC2 public DNS / domain).
# Used for CORS. Example: http://ec2-1-2-3-4.compute.amazonaws.com
CLIENT_URL=http://your-ec2-public-dns

# --- Auth (JWT) ---
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRY=15m

# --- Config-backed admin ---
AUTH_USER_ID=00000000-0000-4000-8000-000000000001
AUTH_USER_NAME=MIST Avinya Admin
AUTH_USER_EMAIL=admin@mistavinya.local
AUTH_USER_PASSWORD_HASH=replace-with-a-bcrypt-hash
AUTH_USER_ROLE=ADMIN

# --- AWS S3 (call recordings) ---
AWS_REGION=ap-south-1
AWS_S3_BUCKET=mist-avinya-recordings
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_PLAYBACK_EXPIRY_SECONDS=300
